# Backend environment variables — COPY THIS FILE to .env and fill in the values.
# The .env file is gitignored and must NEVER be committed.

# ── JWT Authentication ──────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_here

# ── Zego Cloud WebRTC Credentials ──────────────────────────────────────────────
# Get these from: https://console.zegocloud.com → Your Project → AppID & Server Secret
ZEGO_APP_ID=0
ZEGO_SERVER_SECRET=

# ── CORS — Frontend origin ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL, e.g. https://yourdomain.com
# In development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ───────────────────────────────────────────────────────────────────
# Leave empty to use the default SQLite file (zoom_clone.db in the backend directory).
# For PostgreSQL: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=
